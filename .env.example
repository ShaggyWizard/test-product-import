# --- Приложение ---
# dev | prod. В dev Doctrine сама пересобирает прокси и метаданные
APP_ENV=prod
# Порт, на котором nginx отдаёт фронт и /api
HTTP_PORT=8080

# --- База данных (PostgreSQL) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=products
DB_USER=app
DB_PASSWORD=app_secret

# --- RabbitMQ ---
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_secret
# Порт веб-панели RabbitMQ (http://localhost:15672)
RABBITMQ_UI_PORT=15672
# DSN транспорта Symfony Messenger
MESSENGER_TRANSPORT_DSN=amqp://app:app_secret@rabbitmq:5672/%2f/messages

# --- Импорт ---
# Максимальный размер загружаемого .xlsx, байт (10 МБ)
IMPORT_MAX_FILE_SIZE=10485760
# Сколько импортов разрешено с одного IP за окно
IMPORT_RATE_LIMIT=5
# Окно rate limit
IMPORT_RATE_INTERVAL="1 minute"
# Таймаут скачивания одной картинки, секунд
IMAGE_DOWNLOAD_TIMEOUT=10
# Максимальный размер одной картинки, байт (5 МБ)
IMAGE_MAX_SIZE=5242880

# --- Аутентификация (JWT) ---
JWT_SECRET=change_me_to_a_long_random_string
# Время жизни токена, секунд
JWT_TTL=3600
# Единственный пользователь админки
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
